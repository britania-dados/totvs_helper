  <step>
    <name>ELETRO</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DATASUL_EMS2UNIT_ELETRO</connection>
    <sql>SELECT 
    '1' as "empresa",
    SUBSTRING("cod-local",1,6) AS "cod-local", 
    SUBSTRING("cod-estab",1,10) AS "cod-estab", 
    SUBSTRING("cod-item",1,32) AS "cod-item", 
    "num-ciclo-contag", 
    "idi-leitura-invent", 
    CONVERT('bit', CASE WHEN "log-invent-ciclico" &lt;&gt; '1' THEN '0' ELSE '1' END) AS "log-invent-ciclico", 
    case 
        when "dat-ult-contag" &lt;= '01/01/1900' then convert('date', '01/01/1900') 
        when "dat-ult-contag" >= '12/31/9999' then convert('date', '12/31/9999') 
        else convert('date', "dat-ult-contag") 
    end AS "dat-ult-contag", 
    "num-dias-valid", 
    "ind-controle-saida", 
    CONVERT('bit', CASE WHEN "log-compart-box-lote" &lt;&gt; '1' THEN '0' ELSE '1' END) AS "log-compart-box-lote", 
    CONVERT('bit', CASE WHEN "log-validade" &lt;&gt; '1' THEN '0' ELSE '1' END) AS "log-validade", 
    CONVERT('bit', CASE WHEN "log-compart-box-item" &lt;&gt; '1' THEN '0' ELSE '1' END) AS "log-compart-box-item", 
    "num-dias-reanalise", 
    "ind-seq-armazenamento", 
    "ind-seq-retirada", 
    CONVERT('bit', CASE WHEN "log-armazena-prox-picking" &lt;&gt; '1' THEN '0' ELSE '1' END) AS "log-armazena-prox-picking", 
    CONVERT('bit', CASE WHEN "log-exclusivo-picking" &lt;&gt; '1' THEN '0' ELSE '1' END) AS "log-exclusivo-picking", 
    CONVERT('bit', CASE WHEN "log-efetua-packing" &lt;&gt; '1' THEN '0' ELSE '1' END) AS "log-efetua-packing", 
    "ind-unid-contr", 
    CONVERT('bit', CASE WHEN "log-devol-area-picking" &lt;&gt; '1' THEN '0' ELSE '1' END) AS "log-devol-area-picking", 
    CONVERT('bit', CASE WHEN "log-armaz-estado-cq" &lt;&gt; '1' THEN '0' ELSE '1' END) AS "log-armaz-estado-cq", 
    "idi-metod-armazto", 
    "idi-tip-capac-armazto", 
    "idi-classif-abc", 
    CONVERT('bit', CASE WHEN "log-consid-sdo-dest" &lt;&gt; '1' THEN '0' ELSE '1' END) AS "log-consid-sdo-dest"
from PUB."wms-item-estab-local" WITH (NOLOCK)
</sql>
    <limit>0</limit>
    <lookup/>
