    <connection>DATASUL_ESP2UNIT_BRIC</connection>
    <sql>Select 
    substring("cod-estabel",1,10) "cod-estabel", 
    substring("cod-local",1,6) "cod-local", 
    substring("num-docto",1,32) "num-docto", 
    "id-docto", 
    case 
          when "dt-implant"  &lt; '12/31/9999' and "dt-implant" > '01/01/1900' then CONVERT ( 'date',"dt-implant") 
          when "dt-implant"  &lt;= '01/01/1900' then '01/01/1900' 
          when "dt-implant"  >= '12/31/9999' then '12/31/9999' 
    end "dt-implant", 
    case 
          when "dt-atualiz"  &lt; '12/31/9999' and "dt-atualiz" > '01/01/1900' then CONVERT ( 'date',"dt-atualiz") 
          when "dt-atualiz"  &lt;= '01/01/1900' then '01/01/1900' 
          when "dt-atualiz"  >= '12/31/9999' then '12/31/9999' 
    end "dt-atualiz", 
    substring("cod-usuario",1,24) "cod-usuario", 
    substring("cod-depos",1,10) "cod-depos", 
    '35' "EMPRESA"
from pub."br-docto-wms" with (nolock)</sql>
